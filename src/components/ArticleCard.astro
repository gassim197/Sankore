---
import type { CollectionEntry } from 'astro:content';
import Illustration from './Illustration.astro';
import { formatDate } from '../utils/formatDate';
import { readingTime } from '../utils/readingTime';
import { CATEGORY_LABELS } from '../utils/categories';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, excerpt, category, publishedAt, illustration, illustrationProps, image } = article.data;
const minutes   = readingTime(article.body);
const catLabel  = CATEGORY_LABELS[category] ?? category;
const href      = `/articles/${article.slug}`;
---

<a href={href} class="card" data-category={category}>
  <div class="card-illus">
    {image
      ? <img src={image} alt={title} class="card-image" loading="lazy" decoding="async" width="800" height="450" />
      : <Illustration type={illustration} number={illustrationProps?.number} />
    }
  </div>
  <div class="card-content">
    <div class="meta-row">
      <span class="cat">{catLabel}</span>
      <span class="dot"></span>
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      <span class="dot"></span>
      <span>{minutes} min</span>
    </div>
    <h3>{title}</h3>
    <p class="excerpt">{excerpt}</p>
    <span class="read-more">Lire l'article</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-soft);
    align-items: center;
    transition: opacity 0.2s;
    text-decoration: none;
    color: inherit;
  }

  .card:last-child {
    border-bottom: none;
  }

  .card:hover {
    opacity: 0.88;
  }

  .card:hover .card-illus {
    transform: translateY(-3px);
  }

  .card:hover .read-more::after {
    transform: translateX(4px);
  }

  .card-illus {
    aspect-ratio: 4 / 3;
    background: var(--paper-3);
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .card-illus :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    letter-spacing: 0.05em;
    color: var(--ink-mute);
    flex-wrap: wrap;
  }

  .cat {
    color: var(--terracotta);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 500;
    font-size: 10.5px;
  }

  .dot {
    width: 3px;
    height: 3px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
  }

  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.18;
    letter-spacing: -0.018em;
    color: var(--ink);
    font-variation-settings: 'opsz' 144;
  }

  .excerpt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .read-more {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .read-more::after {
    content: '→';
    transition: transform 0.2s;
    display: inline-block;
  }

  /* Mobile */
  @media (max-width: 720px) {
    .card {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .card-illus {
      aspect-ratio: 16 / 10;
      max-width: 100%;
    }

    h3 {
      font-size: 20px;
    }
  }
</style>
