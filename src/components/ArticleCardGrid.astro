---
import type { CollectionEntry } from 'astro:content';
import Illustration from './Illustration.astro';
import { formatDate } from '../utils/formatDate';
import { readingTime } from '../utils/readingTime';
import { CATEGORY_LABELS } from '../utils/categories';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, excerpt, dek, category, publishedAt, illustration, illustrationProps, image } = article.data;
const minutes  = readingTime(article.body);
const catLabel = CATEGORY_LABELS[category] ?? category;
const href     = `/articles/${article.slug}`;
const summary  = excerpt ?? dek ?? '';
---

<a href={href} class="grid-card" data-category={category}>
  <div class="grid-card-illus">
    {image
      ? <img src={image} alt={title} class="grid-card-image" loading="lazy" decoding="async" width="400" height="250" />
      : <Illustration type={illustration} number={illustrationProps?.number} />
    }
  </div>
  <div class="grid-card-content">
    <span class="cat">{catLabel}</span>
    <h3>{title}</h3>
    {summary && <p class="excerpt">{summary}</p>}
    <div class="grid-card-meta">
      <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
      <span class="dot"></span>
      <span>{minutes} min</span>
    </div>
  </div>
</a>

<style>
  .grid-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .grid-card:hover {
    opacity: 0.9;
  }

  .grid-card:hover .grid-card-illus {
    transform: translateY(-3px);
  }

  .grid-card-illus {
    aspect-ratio: 4 / 3;
    background: var(--paper-3);
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease;
    margin-bottom: 18px;
  }

  .grid-card-illus :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .grid-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .grid-card-content {
    display: flex;
    flex-direction: column;
  }

  .cat {
    color: var(--terracotta);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 500;
    font-size: 10.5px;
    margin-bottom: 10px;
  }

  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 10px;
    font-variation-settings: 'opsz' 144;
  }

  .excerpt {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .grid-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--ink-mute);
    margin-top: auto;
  }

  .dot {
    width: 3px;
    height: 3px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
