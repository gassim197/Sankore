---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../utils/readingTime';
import { CATEGORY_LABELS } from '../utils/categories';

interface Props {
  article: CollectionEntry<'articles'>;
  index: number;
}

const ROMAN = ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii'];

const { article, index } = Astro.props;
const { title, category } = article.data;
const roman    = ROMAN[index] ?? String(index + 1);
const catLabel = CATEGORY_LABELS[category] ?? category;
const minutes  = readingTime(article.body);
const href     = `/articles/${article.slug}`;
---

<a href={href} class="essential-card">
  <span class="num" aria-hidden="true">{roman}</span>
  <span class="essential-cat">{catLabel}</span>
  <h4>{title}</h4>
  <span class="essential-meta">{minutes} min de lecture</span>
</a>

<style>
  .essential-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    padding: 24px;
    position: relative;
    transition: transform 0.2s ease;
    border: 1px solid var(--line-soft);
    text-decoration: none;
    color: inherit;
  }

  .essential-card:hover {
    transform: translateY(-3px);
  }

  .num {
    position: absolute;
    top: 14px;
    right: 18px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 32px;
    color: var(--gold);
    opacity: 0.5;
    font-weight: 300;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .essential-cat {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--terracotta);
    margin-bottom: 14px;
    font-weight: 500;
    font-family: var(--sans);
  }

  h4 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.22;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
    flex: 1;
    padding-right: 32px;
  }

  .essential-meta {
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.05em;
    font-style: italic;
    font-family: var(--serif);
  }
</style>
