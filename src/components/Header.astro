---
const pathname = Astro.url.pathname;

type NavItem =
  | { href: string; label: string }
  | { label: string; children: { href: string; label: string }[] };

// Piliers éditoriaux — groupe de gauche
const pillarLinks: { href: string; label: string }[] = [
  { href: '/categories/ia-au-travail',         label: 'IA au travail' },
  { href: '/categories/transformation-digitale', label: 'Transformation digitale' },
  { href: '/categories/decryptages',           label: 'Décryptages' },
  { href: '/categories/outils-methodes',       label: 'Outils & méthodes' },
];

// Fonctions utilitaires — groupe de droite (desktop) / suite de la liste (mobile)
const resourcesDropdown = {
  label: 'Ressources',
  children: [
    { href: '/glossaire',  label: 'Glossaire' },
    { href: '/ressources', label: 'Outils' },
  ],
};

const navLinks: NavItem[] = [
  ...pillarLinks,
  resourcesDropdown,
  { href: '/recherche',  label: 'Recherche' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/a-propos',   label: 'À propos' },
];

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(href + '/');
}

function isGroupActive(children: { href: string }[]): boolean {
  return children.some(({ href }) => isActive(href));
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-link" aria-label="Sankoré — Accueil">
      <div class="brand">Sankor<span class="accent">é</span></div>
      <span class="brand-tag">L'IA au travail, en Afrique</span>
    </a>

    <nav class="main-nav" id="mainNav" aria-label="Navigation principale">
      {navLinks.map((item) => (
        'children' in item ? (
          <div
            class={`nav-dropdown${isGroupActive(item.children) ? ' active' : ''}`}
          >
            <button
              type="button"
              class="nav-dropdown-toggle"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <span class="nav-chevron" aria-hidden="true">▾</span>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              {item.children.map(({ href, label }) => (
                <a
                  href={href}
                  role="menuitem"
                  class={isActive(href) ? 'active' : undefined}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        ) : item.href === '/recherche' ? (
          <a
            href={item.href}
            class={`nav-search${isActive(item.href) ? ' active' : ''}`}
            aria-label="Recherche"
            title="Recherche"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <svg class="nav-search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="nav-search-label">{item.label}</span>
          </a>
        ) : item.href === '/newsletter' ? (
          <a
            href={item.href}
            class={`nav-newsletter-btn${isActive(item.href) ? ' active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ) : item.href === '/a-propos' ? (
          <a
            href={item.href}
            class={`nav-about${isActive(item.href) ? ' active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ) : (
          <a
            href={item.href}
            class={isActive(item.href) ? 'active' : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <button
      class="menu-toggle"
      id="menuToggle"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mainNav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle') as HTMLButtonElement | null;
  const nav    = document.getElementById('mainNav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
  });

  // Ferme le menu quand on clique un lien
  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Ouvrir le menu');
    });
  });

  // Menus déroulants (Ressources)
  const mqMobile = window.matchMedia('(max-width: 980px)');

  nav?.querySelectorAll('.nav-dropdown').forEach(dropdown => {
    const dToggle = dropdown.querySelector('.nav-dropdown-toggle') as HTMLButtonElement | null;
    if (!dToggle) return;

    const setOpen = (open: boolean) => {
      dropdown.classList.toggle('open', open);
      dToggle.setAttribute('aria-expanded', String(open));
    };

    // Mobile : accordéon au clic. Desktop : le survol gère l'ouverture via CSS,
    // mais le clic/clavier reste utile pour l'accessibilité.
    dToggle.addEventListener('click', () => {
      setOpen(!dropdown.classList.contains('open'));
    });

    // Desktop : ferme quand le focus quitte la zone du déroulant
    dropdown.addEventListener('focusout', (e) => {
      if (mqMobile.matches) return;
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !dropdown.contains(next)) setOpen(false);
    });

    // Échap referme le déroulant
    dropdown.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') {
        setOpen(false);
        dToggle.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 237, 224, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }

  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand-link {
    display: block;
    flex-shrink: 0;
  }

  .brand {
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.025em;
    font-variation-settings: 'opsz' 144;
    line-height: 1;
    color: var(--ink);
  }

  .brand .accent {
    color: var(--terracotta);
  }

  .brand-tag {
    display: block;
    font-family: var(--sans);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    margin-top: 3px;
    color: var(--ink-mute);
    font-weight: 500;
  }

  .main-nav {
    display: flex;
    flex: 1;
    gap: 28px;
    align-items: center;
    font-size: 13.5px;
    font-weight: 500;
  }

  /* ── Groupe fonctions (droite) ─────────────────────────────
     Poussé vers le bord droit de la barre, détaché des piliers. */
  .nav-dropdown {
    margin-left: auto;
  }

  .nav-dropdown,
  .nav-search,
  .nav-about,
  .nav-newsletter-btn {
    order: 1;
  }

  .nav-search  { order: 2; }
  .nav-about   { order: 3; }
  .nav-newsletter-btn { order: 4; }

  .main-nav a {
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.18s, color 0.18s;
    position: relative;
    padding: 4px 0;
    white-space: nowrap;
  }

  .main-nav a:hover {
    opacity: 1;
    color: var(--terracotta);
  }

  .main-nav a.active {
    opacity: 1;
    color: var(--ink);
  }

  .main-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--terracotta);
  }

  /* ── Menu déroulant (Ressources) ──────────────────────────── */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--sans);
    font-size: inherit;
    font-weight: 500;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.18s, color 0.18s;
    padding: 4px 0;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: none;
    line-height: inherit;
  }

  .nav-dropdown-toggle:hover,
  .nav-dropdown-toggle:focus-visible {
    opacity: 1;
    color: var(--terracotta);
  }

  .nav-dropdown.active .nav-dropdown-toggle {
    opacity: 1;
    color: var(--ink);
  }

  .nav-chevron {
    font-size: 0.7em;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .nav-dropdown:hover .nav-chevron,
  .nav-dropdown.open .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 160px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(27, 31, 42, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 10;
  }

  /* Petite zone tampon pour ne pas perdre le survol entre l'onglet et le menu */
  .nav-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu,
  .nav-dropdown.open .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 7px 12px;
    border-radius: 6px;
    opacity: 0.85;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, opacity 0.15s;
  }

  .nav-dropdown-menu a:hover,
  .nav-dropdown-menu a:focus-visible {
    opacity: 1;
    color: var(--terracotta);
    background: var(--paper-3);
  }

  .nav-dropdown-menu a.active {
    color: var(--terracotta);
    opacity: 1;
  }

  .nav-dropdown-menu a.active::after {
    display: none;
  }

  /* ── Recherche (icône desktop / texte mobile) ──────────────── */
  .nav-search {
    display: inline-flex;
    align-items: center;
  }

  .nav-search-label {
    display: none;
  }

  /* ── À propos ───────────────────────────────────────────────
     Hérite du style des liens de nav standard (.main-nav a). */

  /* ── Newsletter — bouton d'accent ──────────────────────────── */
  .main-nav a.nav-newsletter-btn {
    display: inline-block;
    background: var(--terracotta);
    color: var(--paper);
    opacity: 1;
    padding: 9px 20px;
    border-radius: 7px;
    transition: background 0.18s;
  }

  .main-nav a.nav-newsletter-btn:hover {
    background: var(--terracotta-deep);
    color: var(--paper);
    opacity: 1;
  }

  .main-nav a.nav-newsletter-btn.active {
    background: var(--terracotta-deep);
  }

  .main-nav a.nav-newsletter-btn.active::after {
    display: none;
  }

  .menu-toggle {
    display: none;
    width: 32px;
    height: 32px;
    position: relative;
    flex-shrink: 0;
  }

  .menu-toggle span {
    position: absolute;
    left: 4px;
    right: 4px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.22s ease, opacity 0.22s ease;
    transform-origin: center;
  }

  .menu-toggle span:nth-child(1) { top: 10px; }
  .menu-toggle span:nth-child(2) { top: 17px; }
  .menu-toggle span:nth-child(3) { top: 24px; }

  /* Animation hamburger → croix */
  .menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Laptop / tablette paysage : la barre se resserre avant
     de basculer en menu hamburger, pour éviter tout débordement. ── */
  @media (max-width: 1240px) {
    .header-inner {
      padding: 18px 20px;
      gap: 16px;
    }

    .main-nav {
      gap: 13px;
      font-size: 12.8px;
    }

    .main-nav a.nav-newsletter-btn {
      padding: 8px 14px;
    }
  }

  @media (max-width: 980px) {
    .main-nav {
      display: none;
    }

    .main-nav.open {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper-2);
      padding: 24px 32px 32px;
      gap: 18px;
      border-bottom: 1px solid var(--line);
      box-shadow: 0 8px 24px rgba(27, 31, 42, 0.08);
    }

    .main-nav.open a {
      font-size: 15px;
      opacity: 1;
    }

    /* Sur mobile, le menu reste une liste simple dans l'ordre du DOM :
       on annule le regroupement/réordonnancement propre au desktop. */
    .main-nav.open .nav-dropdown,
    .main-nav.open .nav-search,
    .main-nav.open .nav-about,
    .main-nav.open .nav-newsletter-btn {
      order: 0;
      margin-left: 0;
    }

    .main-nav.open .nav-search-icon {
      display: none;
    }

    .main-nav.open .nav-search-label {
      display: inline;
    }

    .main-nav.open a.nav-newsletter-btn {
      display: inline-block;
      background: none;
      color: var(--ink);
      opacity: 1;
      padding: 0;
      border-radius: 0;
    }

    .main-nav.open a.nav-newsletter-btn:hover,
    .main-nav.open a.nav-newsletter-btn.active {
      background: none;
      color: var(--terracotta);
    }

    /* Déroulant → accordéon sur mobile */
    .main-nav.open .nav-dropdown {
      width: 100%;
    }

    .main-nav.open .nav-dropdown-toggle {
      font-size: 15px;
      opacity: 1;
      padding: 0;
    }

    .main-nav.open .nav-dropdown-menu {
      position: static;
      transform: none;
      opacity: 1;
      visibility: hidden;
      pointer-events: none;
      display: none;
      min-width: 0;
      width: 100%;
      margin-top: 12px;
      margin-left: 14px;
      padding: 0;
      border: none;
      border-left: 1px solid var(--line);
      border-radius: 0;
      box-shadow: none;
      background: none;
      gap: 14px;
    }

    .main-nav.open .nav-dropdown.open .nav-dropdown-menu {
      display: flex;
      visibility: visible;
      pointer-events: auto;
    }

    /* Sur mobile, le survol ne doit pas ouvrir le menu */
    .main-nav.open .nav-dropdown:hover .nav-dropdown-menu,
    .main-nav.open .nav-dropdown:focus-within .nav-dropdown-menu {
      display: none;
    }

    .main-nav.open .nav-dropdown.open:hover .nav-dropdown-menu,
    .main-nav.open .nav-dropdown.open:focus-within .nav-dropdown-menu {
      display: flex;
    }

    .main-nav.open .nav-dropdown-menu a {
      padding: 0 0 0 14px;
      font-size: 14px;
    }

    .menu-toggle {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding: 16px 20px;
    }

    .brand {
      font-size: 22px;
    }
  }
</style>
