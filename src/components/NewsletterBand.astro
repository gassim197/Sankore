---
---

<section class="newsletter-band">
  <div class="container">
    <p class="eyebrow eyebrow-gold">La lettre du dimanche</p>
    <h2>
      Recevez Sankoré chaque semaine,
      <em>directement dans votre boîte</em>
    </h2>
    <p class="sub">
      La synthèse de la semaine en IA, transformation digitale et gestion de
      projet en Afrique francophone. Une lecture, dix minutes, et l'essentiel
      pour la semaine qui vient.
    </p>

    <form class="newsletter-form" id="nlForm" novalidate>
      <input
        type="email"
        name="email"
        placeholder="votre@email.com"
        required
        autocomplete="email"
        aria-label="Votre adresse e-mail"
      />
      <button type="submit">S'abonner</button>
    </form>

    <p class="error" id="nlError" aria-live="polite"></p>
    <p class="smallprint">Gratuit · Désabonnement en un clic · Pas de spam</p>
    <p class="success" id="nlSuccess" aria-live="polite">
      Merci ! Vous recevrez la prochaine lettre dimanche.
    </p>
  </div>
</section>

<script>
  const form    = document.getElementById('nlForm')    as HTMLFormElement | null;
  const success = document.getElementById('nlSuccess');
  const errorEl = document.getElementById('nlError');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    if (!email) return;

    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';
    if (errorEl) errorEl.style.display = 'none';

    try {
      const res  = await fetch('/api/subscribe', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email }),
      });
      const data = await res.json();

      if (data.ok) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        btn.disabled = false;
        btn.textContent = "S'abonner";
        if (errorEl) {
          errorEl.textContent = data.error ?? 'Une erreur est survenue.';
          errorEl.style.display = 'block';
        }
      }
    } catch {
      btn.disabled = false;
      btn.textContent = "S'abonner";
      if (errorEl) {
        errorEl.textContent = 'Connexion impossible. Vérifiez votre réseau.';
        errorEl.style.display = 'block';
      }
    }
  });
</script>

<style>
  .newsletter-band {
    background: var(--ink);
    color: var(--paper);
    padding: 80px 32px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .newsletter-band::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--terracotta) 0%, var(--gold) 100%);
  }

  .newsletter-band :global(.eyebrow-gold) {
    margin-bottom: 18px;
  }

  h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.15;
    font-variation-settings: 'opsz' 144;
  }

  h2 em {
    font-style: italic;
    color: var(--gold);
  }

  .sub {
    font-size: 16px;
    color: rgba(244, 237, 224, 0.75);
    max-width: 520px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .newsletter-form {
    max-width: 460px;
    margin: 0 auto;
    display: flex;
    gap: 8px;
  }

  .newsletter-form input {
    flex: 1;
    padding: 14px 18px;
    font-family: var(--sans);
    font-size: 14px;
    background: rgba(244, 237, 224, 0.08);
    border: 1px solid rgba(244, 237, 224, 0.15);
    color: var(--paper);
    outline: none;
    transition: border-color 0.2s;
  }

  .newsletter-form input::placeholder {
    color: rgba(244, 237, 224, 0.4);
  }

  .newsletter-form input:focus {
    border-color: var(--gold);
  }

  .newsletter-form button {
    background: var(--terracotta);
    color: var(--paper);
    padding: 14px 24px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .newsletter-form button:hover {
    background: var(--terracotta-deep);
  }

  .newsletter-form button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .error {
    display: none;
    font-size: 13px;
    color: #e8836a;
    margin-top: 10px;
    font-family: var(--sans);
  }

  .smallprint {
    font-size: 12px;
    color: rgba(244, 237, 224, 0.5);
    margin-top: 14px;
  }

  .success {
    display: none;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--gold);
    margin-top: 16px;
  }

  @media (max-width: 580px) {
    h2 {
      font-size: 30px;
    }

    .newsletter-form {
      flex-direction: column;
    }

    .newsletter-form button {
      width: 100%;
    }
  }
</style>
