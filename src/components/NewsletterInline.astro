---
/**
 * NewsletterInline — encart d'inscription à la newsletter en fin d'article.
 * Fond crème contrasté, bordure douce, aligné sur la largeur du corps d'article.
 * Soumission via l'endpoint /api/subscribe (même logique que les autres formulaires).
 */
---

<aside class="nl-inline" aria-labelledby="nlInlineTitle">
  <h3 class="nl-inline-title" id="nlInlineTitle">
    Recevez Sankoré chaque dimanche
  </h3>
  <p class="nl-inline-text">
    Un rendez-vous hebdomadaire sur l'IA au travail, la gestion de projet et
    la transformation digitale en Afrique. Un édito, les articles de la
    semaine, et rien de superflu.
  </p>

  <form class="nl-inline-form" id="nlInlineForm" novalidate>
    <label class="nl-inline-label" for="nlInlineEmail">Votre adresse e-mail</label>
    <div class="nl-inline-row">
      <input
        type="email"
        id="nlInlineEmail"
        name="email"
        placeholder="votre@email.com"
        required
        autocomplete="email"
      />
      <button type="submit">S'inscrire</button>
    </div>
    <p class="nl-inline-reassure">Pas de spam. Désabonnement en un clic.</p>
  </form>

  <p class="nl-inline-error" id="nlInlineError" role="alert" aria-live="assertive"></p>

  <p class="nl-inline-success" id="nlInlineSuccess" role="status" aria-live="polite">
    Merci ! Vous recevrez Sankoré dès dimanche prochain.
  </p>
</aside>

<script>
  const form    = document.getElementById('nlInlineForm') as HTMLFormElement | null;
  const success = document.getElementById('nlInlineSuccess');
  const errorEl = document.getElementById('nlInlineError');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    if (!email) return;

    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';
    if (errorEl) errorEl.style.display = 'none';

    try {
      const res  = await fetch('/api/subscribe', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email }),
      });
      const data = await res.json();

      if (data.ok) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        btn.disabled = false;
        btn.textContent = "S'inscrire";
        if (errorEl) {
          errorEl.textContent = data.error ?? 'Une erreur est survenue.';
          errorEl.style.display = 'block';
        }
      }
    } catch {
      btn.disabled = false;
      btn.textContent = "S'inscrire";
      if (errorEl) {
        errorEl.textContent = 'Connexion impossible. Vérifiez votre réseau.';
        errorEl.style.display = 'block';
      }
    }
  });
</script>

<style>
  .nl-inline {
    max-width: 680px;
    margin: 48px auto;
    padding: 40px 36px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 4px 24px rgba(27, 31, 42, 0.05);
    text-align: center;
  }

  .nl-inline-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin-bottom: 12px;
  }

  .nl-inline-text {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 500px;
    margin: 0 auto 28px;
  }

  .nl-inline-form {
    max-width: 460px;
    margin: 0 auto;
  }

  /* Label présent pour les lecteurs d'écran, masqué visuellement */
  .nl-inline-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nl-inline-row {
    display: flex;
    gap: 8px;
  }

  .nl-inline-row input {
    flex: 1;
    min-width: 0;
    padding: 13px 16px;
    font-family: var(--sans);
    font-size: 14px;
    background: #ffffff;
    border: 1px solid var(--paper-3);
    border-radius: 8px;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
  }

  .nl-inline-row input::placeholder { color: var(--ink-mute); }
  .nl-inline-row input:focus        { border-color: var(--terracotta); }

  .nl-inline-row button {
    background: var(--terracotta);
    color: #ffffff;
    padding: 13px 24px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .nl-inline-row button:hover    { background: var(--terracotta-deep); }
  .nl-inline-row button:disabled { opacity: 0.6; cursor: wait; }

  .nl-inline-reassure {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--ink-mute);
    margin-top: 12px;
  }

  .nl-inline-error {
    display: none;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--terracotta);
    margin-top: 14px;
    line-height: 1.5;
  }

  .nl-inline-success {
    display: none;
    font-family: var(--serif);
    font-style: italic;
    font-size: 19px;
    color: var(--gold);
    margin-top: 4px;
  }

  @media (max-width: 580px) {
    .nl-inline {
      padding: 32px 22px;
      border-radius: 12px;
    }

    .nl-inline-title { font-size: 26px; }

    .nl-inline-row {
      flex-direction: column;
    }

    .nl-inline-row input,
    .nl-inline-row button {
      width: 100%;
      padding: 14px 16px;
    }
  }
</style>
