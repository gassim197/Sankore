---
<div class="ornament" aria-hidden="true">
  <span class="ornament-glyph">❧</span>
</div>

<style>
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 60px 0;
    color: var(--gold);
    opacity: 0.8;
  }

  .ornament::before,
  .ornament::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.4;
    max-width: 120px;
  }

  .ornament-glyph {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    font-weight: 300;
  }
</style>
