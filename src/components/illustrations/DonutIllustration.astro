---
interface Props {
  number?: string;
}
const { number } = Astro.props;

const pct = number ? Math.min(100, Math.max(0, parseFloat(number))) : 60;
const cx = 200, cy = 150, r = 70;
const endAngle = -Math.PI / 2 + (pct / 100) * 2 * Math.PI;
const ex = cx + r * Math.cos(endAngle);
const ey = cy + r * Math.sin(endAngle);
const largeArc = pct > 50 ? 1 : 0;
const d = pct >= 100
  ? `M ${cx},${cy - r} A ${r},${r} 0 1,1 ${cx - 0.01},${cy - r} Z`
  : `M ${cx},${cy - r} A ${r},${r} 0 ${largeArc},1 ${ex.toFixed(1)},${ey.toFixed(1)} L ${cx},${cy} Z`;
---
<svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
  <rect width="400" height="300" fill="#EDE3D2"/>
  <circle cx={cx} cy={cy} r="100" fill="none" stroke="#1B1F2A" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.4"/>
  <path d={d} fill="#C4502E" opacity="0.85"/>
  <circle cx={cx} cy={cy} r="38" fill="#1B1F2A"/>
  {number && (
    <text
      x={cx}
      y={cy + 6}
      font-family="Fraunces, serif"
      font-size="20"
      font-weight="500"
      fill="#F4EDE0"
      text-anchor="middle"
    >{number}</text>
  )}
</svg>
