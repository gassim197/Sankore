---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShortDate, formatMonthYear, capitalize } from '../utils/formatDate';
import { CATEGORY_LABELS } from '../utils/categories';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const sorted = allArticles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Grouper par mois/année
const groups = new Map<string, typeof sorted>();
for (const article of sorted) {
  const key = capitalize(formatMonthYear(article.data.publishedAt));
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(article);
}

// Séparer mois et année pour le formatage du titre
function splitMonthYear(key: string): { month: string; year: string } {
  const parts = key.split(' ');
  const year  = parts[parts.length - 1];
  const month = parts.slice(0, -1).join(' ');
  return { month, year };
}
---

<BaseLayout
  title="Archive — Sankoré"
  description="L'ensemble des articles publiés sur Sankoré depuis le lancement, classés par date."
>

  <!-- ══ HERO ═══════════════════════════════════════════ -->
  <section class="archive-hero">
    <div class="archive-hero-inner">
      <h1>Toutes les <em>publications</em></h1>
      <p>L'ensemble des articles publiés depuis le lancement, classés par date.</p>
    </div>
  </section>

  <!-- ══ CONTENU ARCHIVE ═══════════════════════════════ -->
  <div class="archive-content">

    {[...groups.entries()].map(([key, articles]) => {
      const { month, year } = splitMonthYear(key);
      return (
        <div class="archive-month">
          <h2 class="month-header">{month} <em>{year}</em></h2>
          {articles.map(article => {
            const catLabel = CATEGORY_LABELS[article.data.category] ?? article.data.category;
            const shortDate = formatShortDate(article.data.publishedAt);
            return (
              <a href={`/articles/${article.slug}`} class="archive-item">
                <time
                  class="archive-date"
                  datetime={article.data.publishedAt.toISOString()}
                >
                  {shortDate}
                </time>
                <span class="archive-title">{article.data.title}</span>
                <span class="archive-cat">{catLabel}</span>
              </a>
            );
          })}
        </div>
      );
    })}

    {groups.size === 0 && (
      <p class="empty">Aucun article publié pour le moment.</p>
    )}

  </div>

</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────── */
  .archive-hero {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--line);
  }

  .archive-hero-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 32px;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 48px;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
    font-variation-settings: 'opsz' 144;
  }

  h1 em { font-style: italic; }

  .archive-hero-inner > p {
    font-size: 16px;
    color: var(--ink-soft);
  }

  /* ── Contenu ────────────────────────────────────────── */
  .archive-content {
    max-width: var(--container);
    margin: 0 auto;
    padding: 60px 32px 80px;
  }

  .archive-month {
    margin-bottom: 60px;
  }

  .month-header {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    letter-spacing: -0.015em;
    padding-bottom: 16px;
    margin-bottom: 0;
    border-bottom: 2px solid var(--gold);
    font-variation-settings: 'opsz' 144;
  }

  .month-header em { font-style: italic; }

  .archive-item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-soft);
    align-items: baseline;
    text-decoration: none;
    color: inherit;
    transition: none;
  }

  .archive-item:hover .archive-title {
    color: var(--terracotta);
  }

  .archive-date {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .archive-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    transition: color 0.2s;
  }

  .archive-cat {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--terracotta);
    white-space: nowrap;
    font-family: var(--sans);
    font-weight: 500;
  }

  .empty {
    color: var(--ink-mute);
    font-style: italic;
    font-size: 16px;
    padding: 60px 0;
    text-align: center;
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 720px) {
    h1 { font-size: 36px; }

    .archive-item {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 16px 0;
    }

    .archive-date { font-size: 12px; }

    .archive-title { font-size: 17px; }

    .archive-cat { order: -1; }
  }

  @media (max-width: 480px) {
    h1 { font-size: 28px; }
    .archive-hero-inner  { padding: 0 20px; }
    .archive-content     { padding: 40px 20px 60px; }
  }
</style>
