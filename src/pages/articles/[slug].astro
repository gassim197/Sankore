---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ContinueReading from '../../components/ContinueReading.astro';
import Illustration from '../../components/Illustration.astro';
import Ornament from '../../components/Ornament.astro';
import Comments from '../../components/Comments.astro';
import NewsletterPopup from '../../components/NewsletterPopup.astro';
import { formatDate } from '../../utils/formatDate';
import { readingTime } from '../../utils/readingTime';
import { CATEGORY_LABELS } from '../../utils/categories';

export const getStaticPaths = async () => {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map(entry => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content } = await entry.render();

const {
  title, dek, excerpt, publishedAt, updatedAt, category,
  illustration, illustrationProps, author, image,
} = entry.data;

const catLabel  = CATEGORY_LABELS[category] ?? category;
const catUrl    = `/categories/${category}`;
const minutes   = readingTime(entry.body);
const dateStr   = formatDate(publishedAt);
const siteUrl   = import.meta.env.PUBLIC_SITE_URL ?? 'https://sankore.africa';
const pageUrl   = `${siteUrl}/articles/${entry.slug}`;

/* ── Articles liés ─────────────────────────────────────── */
const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const related: CollectionEntry<'articles'>[] = allArticles
  .filter(a => a.slug !== entry.slug)
  .sort((a, b) => {
    const score = (x: CollectionEntry<'articles'>) =>
      x.data.category === category ? 1 : 0;
    return (score(b) - score(a)) ||
           b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  })
  .slice(0, 3);

/* ── Prochain article (ContinueReading) ────────────────── */
const sorted = allArticles.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const idx         = sorted.findIndex(a => a.slug === entry.slug);
const nextArticle = sorted[idx + 1] as CollectionEntry<'articles'> | undefined;

/* ── JSON-LD Article ───────────────────────────────────── */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  author: { '@type': 'Person', name: author.name },
  datePublished: publishedAt.toISOString(),
  dateModified:  (updatedAt ?? publishedAt).toISOString(),
  image: image ? `${siteUrl}${image}` : `${siteUrl}/og-default.png`,
  publisher: {
    '@type': 'Organization',
    name: 'Sankoré',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};
---

<BaseLayout
  title={`${title} — Sankoré`}
  description={excerpt}
  ogImage={image ?? '/og-default.png'}
  canonical={pageUrl}
  type="article"
>
  <!-- JSON-LD dans le <head> -->
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Barre de progression lecture -->
  <ReadingProgress />

  <!-- ══ EN-TÊTE ARTICLE ══════════════════════════════════ -->
  <header class="article-header">
    <div class="container-narrow">

      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span class="sep" aria-hidden="true">›</span>
        <a href={catUrl}>{catLabel}</a>
      </nav>

      <span class="article-category-badge">{catLabel}</span>

      <h1 class="article-title">{title}</h1>

      {dek && <p class="article-dek">{dek}</p>}

      <div class="article-meta">
        <span class="art-author">Par {author.name}</span>
        <span class="dot" aria-hidden="true"></span>
        <time datetime={publishedAt.toISOString()}>{dateStr}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{minutes} min de lecture</span>
      </div>

    </div>
  </header>

  <!-- ══ HERO PLEINE LARGEUR ════════════════════════════ -->
  <div class="article-feature" aria-hidden={!image}>
    {image
      ? <img src={image} alt={title} class="article-feature-image" loading="eager" fetchpriority="high" decoding="async" width="1200" height="630" />
      : <Illustration type={illustration} number={illustrationProps?.number} />
    }
  </div>

  <!-- ══ CORPS MDX ════════════════════════════════════════ -->
  <article class="article-body" id="articleBody">
    <Content />
  </article>

  <Ornament />

  <!-- ══ BLOC AUTEUR ══════════════════════════════════════ -->
  <div class="author-block">
    <div class="author-avatar" aria-hidden="true">
      {author.name === 'Gassimou Cissé' ? (
        <img
          src="/gassimou-cisse.jpg"
          alt="Gassimou Cissé, fondateur de Sankoré"
          width="80"
          height="80"
          loading="lazy"
          class="author-avatar-photo"
        />
      ) : author.initial}
    </div>
    <div class="author-info">
      <h4>{author.name}</h4>
      <p class="author-role">{author.role} · Sankoré</p>
      <p>{author.bio}</p>
    </div>
  </div>

  <!-- ══ CTA NEWSLETTER INLINE ════════════════════════════ -->
  <div class="article-cta-newsletter">
    <h4>Vous avez aimé cet article ?</h4>
    <p>
      Recevez les prochaines analyses chaque dimanche —
      directement dans votre boîte.
    </p>
    <form class="cta-form" id="ctaForm" novalidate>
      <input
        type="email"
        name="email"
        placeholder="votre@email.com"
        required
        aria-label="Votre adresse e-mail"
      />
      <button type="submit">S'abonner</button>
    </form>
    <p class="cta-error" id="ctaError" aria-live="polite"></p>
    <p class="cta-success" id="ctaSuccess" aria-live="polite">
      Merci — à dimanche&nbsp;!
    </p>
  </div>

  <!-- ══ BOUTONS PARTAGE ══════════════════════════════════ -->
  <div class="article-end">
    <h2 class="share-title">Partager cet article</h2>
    <div class="share-buttons">
    <a
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn linkedin"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      Partager sur LinkedIn
    </a>

    <a
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn social facebook"
      aria-label="Partager sur Facebook"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M15.12 5.32H17V2.14A26.11 26.11 0 0 0 14.26 2c-2.72 0-4.58 1.66-4.58 4.7v2.6H6.61v3.56h3.07V22h3.68v-9.54h3.06l.46-3.56h-3.52V7.05c0-1.03.28-1.73 1.76-1.73z"/>
      </svg>
    </a>

    <a
      href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn social x"
      aria-label="Partager sur X"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
      </svg>
    </a>

    <a
      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} ${pageUrl}`)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn social whatsapp"
      aria-label="Partager sur WhatsApp"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.465 3.488"/>
      </svg>
    </a>

    <button class="share-btn" data-share="copy" type="button">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
      Copier le lien
    </button>
    </div>
  </div>

  <!-- ══ COMMENTAIRES GISCUS ═════════════════════════════ -->
  <Comments />

  <!-- ══ ARTICLES LIÉS ════════════════════════════════════ -->
  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h3>Articles <em>liés</em></h3>
        <div class="related-grid">
          {related.map(rel => {
            const rCat     = CATEGORY_LABELS[rel.data.category] ?? rel.data.category;
            const rMinutes = readingTime(rel.body);
            return (
              <a href={`/articles/${rel.slug}`} class="related-card">
                <div class="related-illus">
                  <Illustration
                    type={rel.data.illustration}
                    number={rel.data.illustrationProps?.number}
                  />
                </div>
                <div class="related-content">
                  <div class="related-meta">
                    <span class="rel-cat">{rCat}</span>
                    <span class="rel-dot" aria-hidden="true"></span>
                    <span>{rMinutes} min</span>
                  </div>
                  <h4>{rel.data.title}</h4>
                  <p>{rel.data.excerpt}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ══ ENCART FLOTTANT "LIRE ENSUITE" ══════════════════ -->
  <ContinueReading next={nextArticle} />

  <!-- ══ POPUP NEWSLETTER (50% scroll, masquage 7j) ═══════ -->
  <NewsletterPopup />

</BaseLayout>

<!-- Copier le lien -->
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share="copy"]').forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        btn.textContent = '✓ Lien copié !';
        setTimeout(() => {
          btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Copier le lien`;
        }, 2000);
      } catch { /* clipboard API non disponible */ }
    });
  });
</script>

<!-- Newsletter CTA inline -->
<script>
  const form    = document.getElementById('ctaForm')    as HTMLFormElement | null;
  const success = document.getElementById('ctaSuccess');
  const errorEl = document.getElementById('ctaError');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value?.trim();
    if (!email) return;

    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';
    if (errorEl) errorEl.style.display = 'none';

    try {
      const res  = await fetch('/api/subscribe', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email }),
      });
      const data = await res.json();

      if (data.ok) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        btn.disabled = false;
        btn.textContent = "S'abonner";
        if (errorEl) {
          errorEl.textContent = data.error ?? 'Une erreur est survenue.';
          errorEl.style.display = 'block';
        }
      }
    } catch {
      btn.disabled = false;
      btn.textContent = "S'abonner";
      if (errorEl) {
        errorEl.textContent = 'Connexion impossible. Vérifiez votre réseau.';
        errorEl.style.display = 'block';
      }
    }
  });
</script>

<style>
  /* ── En-tête ──────────────────────────────────────────── */
  .article-header {
    padding: 60px 0 40px;
    text-align: center;
  }

  .breadcrumb {
    font-size: 12px;
    color: var(--ink-mute);
    letter-spacing: 0.05em;
    margin-bottom: 28px;
  }

  .breadcrumb a {
    color: var(--ink-mute);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover { color: var(--terracotta); }

  .sep {
    margin: 0 8px;
    color: var(--gold);
  }

  .article-category-badge {
    display: inline-block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--terracotta);
    margin-bottom: 24px;
    font-weight: 500;
    font-family: var(--sans);
  }

  .article-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 52px;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 24px;
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
    font-variation-settings: 'opsz' 144;
  }

  .article-dek {
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 640px;
    margin: 0 auto 40px;
    font-weight: 300;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    gap: 14px;
    font-size: 13px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
    align-items: center;
    flex-wrap: wrap;
  }

  .art-author { color: var(--ink); font-weight: 500; }

  .dot {
    width: 3px;
    height: 3px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Illustration hero pleine largeur ─────────────────── */
  .article-feature {
    height: 380px;
    background: var(--paper-3);
    margin: 40px 0 60px;
    position: relative;
    overflow: hidden;
  }

  .article-feature :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .article-feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Bloc auteur ──────────────────────────────────────── */
  .author-block {
    max-width: 680px;
    margin: 60px auto;
    padding: 32px;
    background: var(--paper-2);
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--paper-3);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: 28px;
    color: var(--terracotta);
    font-weight: 500;
    overflow: hidden;
  }

  .author-avatar-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .author-info h4 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 20px;
    margin-bottom: 4px;
  }

  .author-role {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--terracotta);
    margin-bottom: 12px;
    font-family: var(--sans);
  }

  .author-info p:last-child {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ── CTA newsletter inline ────────────────────────────── */
  .article-cta-newsletter {
    max-width: 680px;
    margin: 60px auto;
    padding: 40px 32px;
    text-align: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .article-cta-newsletter h4 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 24px;
    margin-bottom: 12px;
    letter-spacing: -0.015em;
    font-variation-settings: 'opsz' 144;
  }

  .article-cta-newsletter p {
    font-size: 15px;
    color: var(--ink-soft);
    margin-bottom: 24px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .cta-form {
    display: flex;
    max-width: 420px;
    margin: 0 auto;
    gap: 8px;
  }

  .cta-form input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    font-family: var(--sans);
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
    color: var(--ink);
  }

  .cta-form input:focus { border-color: var(--terracotta); }

  .cta-form button {
    background: var(--ink);
    color: var(--paper);
    padding: 12px 20px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .cta-form button:hover    { background: var(--terracotta); }
  .cta-form button:disabled { opacity: 0.6; cursor: wait; }

  .cta-error {
    display: none;
    font-size: 13px;
    color: var(--terracotta);
    margin-top: 8px;
    font-family: var(--sans);
    line-height: 1.5;
  }

  .cta-success {
    display: none;
    font-family: var(--serif);
    font-style: italic;
    font-size: 17px;
    color: var(--gold);
  }

  /* ── Boutons partage ──────────────────────────────────── */
  .article-end {
    max-width: 680px;
    margin: 40px auto 80px;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .share-title {
    font-family: var(--serif);
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 16px;
    text-align: center;
  }

  .share-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .share-btn {
    font-family: var(--sans);
    font-size: 13px;
    padding: 12px 22px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper-2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    cursor: pointer;
    text-decoration: none;
  }

  .share-btn:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .share-btn.linkedin {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .share-btn.linkedin:hover {
    background: var(--terracotta);
    border-color: var(--terracotta);
  }

  /* ── Boutons réseaux (icône seule) ────────────────────── */
  .share-btn.social {
    padding: 12px 16px;
  }

  .share-btn.social:hover {
    background: var(--paper-2);
    color: var(--ink);
    border-color: var(--line);
  }

  .share-btn.social.facebook:hover { color: #1877F2; }
  .share-btn.social.x:hover        { color: #000000; }
  .share-btn.social.whatsapp:hover { color: #25D366; }

  /* ── Articles liés ────────────────────────────────────── */
  .related-section {
    background: var(--paper-2);
    padding: 80px 0;
    border-top: 1px solid var(--line);
  }

  .related-section h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    margin-bottom: 32px;
    letter-spacing: -0.018em;
