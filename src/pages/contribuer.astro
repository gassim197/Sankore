---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
---

<BaseLayout
  title="Écrire avec nous — Sankoré"
  description="Sankoré accueille des contributions de cadres, experts et praticiens du continent. Proposez votre analyse, retour d'expérience ou tutoriel."
>

  <!-- ══ HERO ═══════════════════════════════════════════ -->
  <section class="contrib-hero">
    <div class="contrib-hero-inner">
      <p class="eyebrow">Contribuer à Sankoré</p>
      <h1>Vous avez une expertise à <em>partager</em>. Écrivons ensemble.</h1>
      <p class="sub">
        Sankoré accueille des contributions ponctuelles de cadres, experts
        et praticiens du continent africain francophone.
      </p>
    </div>
  </section>

  <!-- ══ GRILLE 4 BLOCS ════════════════════════════════ -->
  <div class="contrib-grid">
    <div class="contrib-block">
      <p class="step">i. Pour qui</p>
      <h3>Qui peut écrire</h3>
      <ul>
        <li>Cadres en poste (chef de projet, RH, commercial, IT, communication)</li>
        <li>Entrepreneurs et fondateurs de startups</li>
        <li>Consultants spécialisés en IA, digital, gestion</li>
        <li>Universitaires et chercheurs en sciences appliquées</li>
        <li>Étudiants avancés (master, doctorat) avec un sujet original</li>
      </ul>
    </div>

    <div class="contrib-block">
      <p class="step">ii. Quoi</p>
      <h3>Quels formats</h3>
      <ul>
        <li><strong>Analyse</strong> — 1 500 à 2 500 mots, sur un sujet de fond</li>
        <li><strong>Retour d'expérience</strong> — 1 000 à 1 800 mots, projet réel et leçons</li>
        <li><strong>Tribune</strong> — 800 à 1 200 mots, opinion argumentée</li>
        <li><strong>Tutoriel</strong> — 1 000 à 2 000 mots avec captures et exemples</li>
        <li><strong>Comparatif d'outils</strong> — 1 200 à 2 000 mots, méthode rigoureuse</li>
      </ul>
    </div>

    <div class="contrib-block">
      <p class="step">iii. Critères</p>
      <h3>Ce qu'on attend</h3>
      <ul>
        <li>Pertinence pour le contexte ouest-africain francophone</li>
        <li>Argumentation fondée sur l'expérience ou des sources</li>
        <li>Ton pragmatique, jamais hype, jamais condescendant</li>
        <li>Pas d'auto-promotion déguisée</li>
        <li>Originalité — pas un texte déjà publié ailleurs</li>
      </ul>
    </div>

    <div class="contrib-block">
      <p class="step">iv. Comment</p>
      <h3>Le processus</h3>
      <ul>
        <li>Vous nous envoyez un pitch (3-5 lignes) via le formulaire</li>
        <li>Nous répondons sous 7 jours avec un avis et des conseils</li>
        <li>Si validé : 2 à 3 semaines pour rédiger</li>
        <li>Édition collaborative : 1 à 2 allers-retours</li>
        <li>Publication avec votre signature et bio</li>
      </ul>
    </div>
  </div>

  <!-- ══ FORMULAIRE ════════════════════════════════════ -->
  <section class="contrib-form-section">
    <h2>Proposez votre sujet</h2>
    <p>
      Décrivez en quelques lignes le sujet, votre angle, ce que vous voulez
      démontrer. Pas besoin d'un texte abouti — un bon pitch suffit.
    </p>

    <form class="contrib-form" id="contribForm" novalidate>
      <div class="row">
        <input type="text"  name="firstname" placeholder="Prénom"  required autocomplete="given-name" />
        <input type="text"  name="lastname"  placeholder="Nom"     required autocomplete="family-name" />
      </div>
      <div class="row">
        <input type="email" name="email"     placeholder="Email"   required autocomplete="email" />
        <input type="text"  name="position"  placeholder="Fonction · Organisation" />
      </div>
      <select name="type">
        <option value="">Type de contribution</option>
        <option value="analyse">Analyse de fond</option>
        <option value="rex">Retour d'expérience</option>
        <option value="tribune">Tribune / Opinion</option>
        <option value="tutoriel">Tutoriel</option>
        <option value="comparatif">Comparatif d'outils</option>
        <option value="autre">Autre / À discuter</option>
      </select>
      <input type="text" name="title" placeholder="Titre provisoire de votre article" />
      <textarea name="pitch" placeholder="Décrivez votre sujet en 3-5 lignes." required></textarea>
      <button type="submit">Envoyer mon pitch</button>
    </form>

    <p class="form-success" id="contribSuccess" aria-live="polite">
      Merci ! Nous vous répondrons sous 7 jours.
    </p>
  </section>

  <NewsletterBand />

</BaseLayout>

<script>
  const form    = document.getElementById('contribForm') as HTMLFormElement | null;
  const success = document.getElementById('contribSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());

    const btn = form.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Envoi…';

    try {
      const res = await fetch('/api/contribute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok || res.status === 404) {
        // 404 = API pas encore implémentée, on simule le succès
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        btn.disabled = false;
        btn.textContent = 'Envoyer mon pitch';
      }
    } catch {
      // API non disponible, on affiche quand même le succès
      form.style.display = 'none';
      if (success) success.style.display = 'block';
    }
  });
</script>

<style>
  /* ── Hero ──────────────────────────────────────────── */
  .contrib-hero {
    padding: 80px 0 60px;
  }

  .contrib-hero-inner {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }

  .contrib-hero-inner :global(.eyebrow) {
    margin-bottom: 20px;
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 56px;
    line-height: 1.08;
    letter-spacing: -0.028em;
    margin-bottom: 28px;
    font-variation-settings: 'opsz' 144;
  }

  h1 em {
    font-style: italic;
    color: var(--terracotta);
  }

  .sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.55;
    color: var(--ink-soft);
    font-weight: 300;
    max-width: 660px;
    margin: 0 auto;
  }

  /* ── Grille 4 blocs ─────────────────────────────────── */
  .contrib-grid {
    max-width: var(--container);
    margin: 60px auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .contrib-block {
    padding: 36px;
    background: var(--paper-2);
  }

  .step {
    font-family: var(--serif);
    font-style: italic;
    font-size: 14px;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .contrib-block h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.2;
    margin-bottom: 18px;
    letter-spacing: -0.015em;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
    padding: 10px 0 10px 24px;
    border-bottom: 1px solid var(--line-soft);
    position: relative;
  }

  li:last-child { border-bottom: none; }

  li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--terracotta);
    font-weight: 500;
  }

  li strong { color: var(--ink); font-weight: 600; }

  /* ── Formulaire ─────────────────────────────────────── */
  .contrib-form-section {
    max-width: 720px;
    margin: 0 auto 0;
    padding: 60px 32px;
    background: var(--ink);
    color: var(--paper);
    position: relative;
  }

  .contrib-form-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--terracotta), var(--gold));
  }

  .contrib-form-section h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 32px;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 144;
  }

  .contrib-form-section > p {
    color: rgba(244, 237, 224, 0.7);
    font-size: 15px;
    margin-bottom: 32px;
    max-width: 540px;
    line-height: 1.6;
  }

  .contrib-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .contrib-form input,
  .contrib-form textarea,
  .contrib-form select {
    padding: 13px 16px;
    background: rgba(244, 237, 224, 0.06);
    border: 1px solid rgba(244, 237, 224, 0.15);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14.5px;
    outline: none;
    transition: border-color 0.2s;
  }

  .contrib-form input::placeholder,
  .contrib-form textarea::placeholder { color: rgba(244, 237, 224, 0.4); }
  .contrib-form select { color: rgba(244, 237, 224, 0.7); }
  .contrib-form select option { color: var(--ink); background: var(--paper); }

  .contrib-form input:focus,
  .contrib-form textarea:focus,
  .contrib-form select:focus { border-color: var(--gold); }

  .contrib-form textarea {
    min-height: 140px;
    resize: vertical;
  }

  .contrib-form button {
    background: var(--terracotta);
    color: var(--paper);
    padding: 16px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    letter-spacing: 0.02em;
    margin-top: 8px;
    transition: background 0.2s;
  }

  .contrib-form button:hover    { background: var(--terracotta-deep); }
  .contrib-form button:disabled { opacity: 0.6; cursor: wait; }

  .form-success {
    display: none;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--gold);
    margin-top: 16px;
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 880px) {
    .contrib-grid { grid-template-columns: 1fr; gap: 24px; }
    h1 { font-size: 40px; }
  }

  @media (max-width: 580px) {
    h1 { font-size: 32px; }
    .sub { font-size: 18px; }
    .row { grid-template-columns: 1fr; }
    .contrib-form-section { padding: 40px 20px; }
    .contrib-hero-inner { padding: 0 20px; }
    .contrib-grid { padding: 0 20px; }
  }
</style>
