---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import WriteWithUsBand from '../components/WriteWithUsBand.astro';
---

<BaseLayout
  title="Ressources & Outils — Sankoré"
  description="Les outils IA et digitaux recommandés par Sankoré, testés dans le contexte africain. Avec mention du tarif, de la langue et de l'accessibilité mobile."
>
  <main class="ressources-page">

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <p class="page-label">Sélection Sankoré</p>
        <h1 class="page-title">Ressources & Outils</h1>
        <p class="page-subtitle">Les outils IA et digitaux que nous utilisons et recommandons, testés dans le contexte africain. Pour chaque outil : le tarif, la langue, et si ça tient sur mobile avec une connexion instable.</p>
        <nav class="section-nav">
          <a href="#ia-generalistes">Assistants IA</a>
          <a href="#creation">Création de contenu</a>
          <a href="#projet">Gestion de projet</a>
          <a href="#automatisation">Automatisation</a>
        </nav>
      </div>
    </section>

    <!-- Section 1 : Assistants IA généralistes -->
    <section class="tools-section" id="ia-generalistes">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">01</span>
          <h2>Assistants IA généralistes</h2>
          <p>Pour la rédaction, l'analyse, la prise de décision et les tâches complexes du quotidien.</p>
        </div>
        <div class="tools-grid">

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Claude</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">L'assistant IA le plus capable pour les tâches de fond : rédaction longue, analyse de documents, aide à la décision, code. Excellent sur les projets complexes. Recommandé par Sankoré pour les chefs de projet et entrepreneurs.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Pro</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://claude.ai" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">ChatGPT</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Le plus connu, excellent pour la créativité, la recherche rapide et la génération d'idées. GPT-4o accessible gratuitement avec des limites. Large communauté de partage de prompts en ligne.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Plus</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://chatgpt.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Google Gemini</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Idéal si vous travaillez déjà dans l'écosystème Google (Gmail, Docs, Sheets, Drive). S'intègre nativement dans votre environnement Google existant. Entièrement gratuit.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://gemini.google.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Perplexity AI</h3>
            </div>
            <p class="tool-desc">IA de recherche web en temps réel. Parfait pour vérifier des informations récentes, faire de la veille ou sourcer des données fiables avec citations. Version gratuite solide et suffisante pour un usage courant.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Pro</span>
              <span class="badge badge-lang">Anglais (principalement)</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://perplexity.ai" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 2 : Création de contenu -->
    <section class="tools-section alt-bg" id="creation">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">02</span>
          <h2>Création de contenu</h2>
          <p>Pour générer des images, des voix, des vidéos et des visuels professionnels.</p>
        </div>
        <div class="tools-grid">

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">ElevenLabs</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Génération de voix IA réalistes en français et dans de nombreuses langues. Pour des narrations audio, podcasts ou contenus vocaux professionnels. La qualité des voix générées est remarquable même en version gratuite.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Pro</span>
              <span class="badge badge-lang">Multilingue</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://elevenlabs.io" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">KlingAI</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Génération de vidéos IA de haute qualité à partir de texte ou d'images. Idéal pour créer des visuels animés pour les réseaux sociaux, les présentations ou les supports de communication.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Pro</span>
              <span class="badge badge-lang">Anglais</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://klingai.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Ideogram</h3>
            </div>
            <p class="tool-desc">Génération d'images IA. Particulièrement fort pour les images avec du texte intégré et les visuels éditoriaux. Excellent rapport qualité/gratuité. Utilisé par Sankoré pour ses illustrations d'articles.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit</span>
              <span class="badge badge-lang">Anglais</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://ideogram.ai" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Canva AI</h3>
            </div>
            <p class="tool-desc">Suite design complète avec fonctionnalités IA intégrées. La version gratuite est très généreuse. Interface en français, idéal pour les visuels réseaux sociaux, présentations et supports de communication.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Pro</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://canva.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 3 : Gestion de projet -->
    <section class="tools-section" id="projet">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">03</span>
          <h2>Gestion de projet</h2>
          <p>Pour organiser le travail, suivre les tâches et collaborer en équipe.</p>
        </div>
        <div class="tools-grid">

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Notion</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Espace de travail tout-en-un : notes, bases de données, wikis, gestion de projet. IA intégrée pour rédiger et synthétiser. Version gratuite solide pour une personne ou une petite équipe.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Plus</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://notion.so" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">ClickUp</h3>
            </div>
            <p class="tool-desc">Gestion de projet avancée avec automatisations intégrées. Adapté aux équipes avec des workflows complexes. Version gratuite très généreuse. Concurrent sérieux à Asana ou Monday.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Business</span>
              <span class="badge badge-lang">Anglais (principalement)</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://clickup.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Trello</h3>
            </div>
            <p class="tool-desc">Le plus simple pour commencer : tableaux Kanban visuels, prise en main en 15 minutes. Idéal pour les petites équipes ou la gestion personnelle de tâches. Gratuit pour jusqu'à 10 tableaux.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Standard</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Mobile</span>
            </div>
            <a href="https://trello.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 4 : Automatisation -->
    <section class="tools-section alt-bg" id="automatisation">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">04</span>
          <h2>Automatisation</h2>
          <p>Pour connecter vos outils entre eux et automatiser les tâches répétitives sans écrire de code.</p>
        </div>
        <div class="tools-grid">

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Zapier</h3>
              <span class="sankore-pick">✦ Choix Sankoré</span>
            </div>
            <p class="tool-desc">Connecte des milliers d'applications entre elles sans code. Interface visuelle, prise en main rapide. Version gratuite limitée à 5 automatisations actives — suffisant pour commencer et tester.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit limité + Starter</span>
              <span class="badge badge-lang">Anglais</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://zapier.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Make</h3>
            </div>
            <p class="tool-desc">Alternative à Zapier, plus puissant pour les workflows complexes. Version gratuite plus généreuse (1000 opérations/mois). Interface visuelle par blocs. Recommandé quand Zapier devient limitant.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Core</span>
              <span class="badge badge-lang">Anglais</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://make.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

          <div class="tool-card">
            <div class="tool-top">
              <h3 class="tool-name">Brevo</h3>
            </div>
            <p class="tool-desc">Plateforme d'emailing et newsletter. Version gratuite généreuse (300 emails/jour). Interface en français, bien adaptée au contexte africain par son tarif compétitif. Utilisé par Sankoré pour sa newsletter.</p>
            <div class="tool-badges">
              <span class="badge badge-free">Gratuit + Starter</span>
              <span class="badge badge-lang">Français</span>
              <span class="badge badge-mobile">Web</span>
            </div>
            <a href="https://brevo.com" target="_blank" rel="noopener" class="tool-link">Accéder →</a>
          </div>

        </div>
      </div>
    </section>

  </main>

  <NewsletterBand />
  <WriteWithUsBand />
</BaseLayout>

<style>
  .ressources-page { background: var(--paper); }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .page-hero {
    padding: 80px 0 60px;
    border-bottom: 1px solid var(--paper-3);
  }

  .page-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--terracotta);
    margin-bottom: 16px;
  }

  .page-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    color: var(--ink);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .page-subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 680px;
    margin-bottom: 40px;
  }

  .section-nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .section-nav a {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--paper-3);
    padding: 8px 18px;
    background: var(--paper-2);
    transition: all 0.2s;
  }

  .section-nav a:hover {
    background: var(--terracotta);
    color: #fff;
    border-color: var(--terracotta);
  }

  .tools-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--paper-3);
  }

  .tools-section.alt-bg { background: var(--paper-2); }

  .section-header { margin-bottom: 48px; }

  .section-tag {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--gold);
    display: block;
    margin-bottom: 12px;
  }

  .section-header h2 {
    font-family: 'Instrument Serif', serif;
    font-size: 32px;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .section-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* Tools grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .tool-card {
    background: var(--paper);
    border: 1px solid var(--paper-3);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.2s;
  }

  .tool-card:hover { border-color: var(--terracotta); }

  .tools-section.alt-bg .tool-card { background: var(--paper); }

  .tool-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tool-name {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .sankore-pick {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--terracotta);
    font-weight: 600;
    white-space: nowrap;
  }

  .tool-desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: var(--ink-soft);
    flex: 1;
    margin: 0;
  }

  /* Badges */
  .tool-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .badge {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid transparent;
  }

  .badge-free {
    background: rgba(184, 148, 59, 0.12);
    color: var(--gold);
    border-color: rgba(184, 148, 59, 0.2);
  }

  .badge-lang {
    background: rgba(196, 80, 46, 0.08);
    color: var(--terracotta);
    border-color: rgba(196, 80, 46, 0.15);
  }

  .badge-mobile {
    background: rgba(27, 31, 42, 0.06);
    color: var(--ink-soft);
    border-color: rgba(27, 31, 42, 0.1);
  }

  .tool-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s;
    margin-top: 4px;
  }

  .tool-link:hover { color: var(--terracotta); }

  @media (max-width: 600px) {
    .tools-grid { grid-template-columns: 1fr; }
    .page-hero { padding: 48px 0 40px; }
    .tools-section { padding: 48px 0; }
  }
</style>
